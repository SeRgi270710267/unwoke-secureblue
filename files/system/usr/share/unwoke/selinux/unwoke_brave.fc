# UNWOKE-SHIPPED-FIRST
# ELF entry points only. /usr/bin/brave-origin is a wrapper script and must
# stay bin_t so it runs unconfined, then execs these and transitions to brave_t.
/opt/brave\.com/brave-origin/brave		--	gen_context(system_u:object_r:brave_exec_t,s0)
/opt/brave\.com/brave-origin/brave-origin	--	gen_context(system_u:object_r:brave_exec_t,s0)
