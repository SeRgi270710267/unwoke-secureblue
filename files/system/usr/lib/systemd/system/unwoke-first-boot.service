# UNWOKE-SHIPPED-FIRST
[Unit]
Description=Unwoke SecureBlue first-boot (signed updates, flavor setup)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/unwoke/first-boot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
