# UNWOKE-SHIPPED-FIRST
# Do not block GDM. Ask in Unwoke setup (default No).
[Unit]
Description=Unwoke: mark USBGuard as pending (ask in Setup, default skip)
After=local-fs.target
ConditionPathExists=/usr/libexec/unwoke/usbguard-prompt.sh
ConditionPathExists=!/etc/unwoke/usbguard-prompt.done

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/unwoke/usbguard-prompt.sh --defer
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
