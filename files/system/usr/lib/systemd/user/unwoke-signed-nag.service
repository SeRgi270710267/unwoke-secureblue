[Unit]
Description=Unwoke: nag until the signed image is booted
ConditionPathExists=/etc/unwoke/signed-staged

[Service]
Type=oneshot
TimeoutStartSec=180
ExecStart=/usr/bin/bash /usr/libexec/unwoke/signed-nag.sh
