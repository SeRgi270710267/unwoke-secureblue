[Unit]
Description=unwoke: remask user Flatpak browsers unless allow-browsers is on
After=default.target
ConditionPathExists=/usr/share/unwoke/flavor
ConditionPathExists=!/etc/unwoke/allow-browsers

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/unwoke/browser-guard.sh apply --user
RemainAfterExit=yes

[Install]
WantedBy=default.target
